<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="derico.blicca.promoblock">

  <genericsetup:registerProfile
      name="1001"
      title="derico.blicca.promoblock: upgrade to 1001"
      directory="1001"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1000"
      destination="1001"
      profile="derico.blicca.promoblock:default">

    <!-- No Python handler: everything this version adds to an installed site
         is declarative, and the upgrade profile carries exactly the one file
         that changed. The scaffolded `reload_gs_profile` handler was dropped
         because it re-imports every step of the DEFAULT profile, browser
         layer and rolemap included, on a site an administrator may have
         adjusted since.

         `import_steps` narrows it once more: without it GenericSetup runs
         every registered import step against this profile, and a step whose
         file is merely absent still runs its handler, so the package's own
         uninstall step would fire during an upgrade. One file, one step,
         named.

         The registry copy under `1001/` is a duplicate of
         `profiles/default/registry.xml` ON PURPOSE, not an oversight to be
         factored out: the default profile is what a FRESH install imports,
         this one is what an EXISTING site at 1000 imports, and GenericSetup
         gives no way to point the second at the first. A test holds the two
         in lockstep so the copy cannot drift. -->
    <genericsetup:upgradeDepends
        title="Register the Promo block add-on record"
        description="Import the IAuroraBlockAddon record that makes the committed promo bundle discoverable"
        import_profile="derico.blicca.promoblock.upgrades:1001"
        import_steps="plone.app.registry"
        />

  </genericsetup:upgradeSteps>

</configure>
