<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="derico.blicca.promoblock">

  <genericsetup:registerProfile
      name="1003"
      title="derico.blicca.promoblock: upgrade to 1003"
      directory="1003"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1002"
      destination="1003"
      profile="derico.blicca.promoblock:default">

    <genericsetup:upgradeStep
        title="Delete the block_api record"
        description="Block add-ons are checked by the names their bundles import (ADR 0024, plone.blicca.auroraeditor): delete this add-on's own orphaned block_api record."
        handler=".v1003.upgrade"
        />

  </genericsetup:upgradeSteps>

</configure>
